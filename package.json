{
  "name": "meccha-chameleon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "build:file": "tsc && vite build --base ./ --outDir file-dist && node scripts/write-file-index.mjs",
    "test": "vitest run src",
    "test:browser": "npm run build:file && playwright test",
    "check": "npm run build && npm run test && npm run test:browser"
  },
  "dependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "three": "^0.168.0",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.1",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
